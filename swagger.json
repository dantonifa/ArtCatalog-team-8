{
  "openapi": "3.0.0",
  "info": {
    "title": "ArtCatalog Team 8 API",
    "version": "1.0.0",
    "description": "Public GET routes are available to everyone. Administrative POST, PUT, and DELETE operations require GitHub authentication."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://artcatalog-team-8.onrender.com"
    }
  ],
  "paths": {
    "/auth/github": {
      "get": {
        "summary": "GitHub OAuth Login",
        "description": "Starts GitHub authentication.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub"
          }
        }
      }
    },

    "/auth/me": {
      "get": {
        "summary": "Current Authenticated User",
        "description": "Returns information about the currently authenticated user.",
        "responses": {
          "200": {
            "description": "Authenticated user"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },

    "/auth/logout": {
      "get": {
        "summary": "Logout current user",
        "description": "Logs out the current authenticated user and destroys the session.",
        "responses": {
          "200": {
            "description": "Successfully logged out"
          }
        }
      }
    },

    "/artists": {
      "get": {
        "summary": "List all artists",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Create a new artist",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Artist created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },

    "/artists/{id}": {
      "get": {
        "summary": "Get one artist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Artist not found"
          }
        }
      },
      "put": {
        "summary": "Update an artist",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artist updated"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Artist not found"
          }
        }
      },
      "delete": {
        "summary": "Delete an artist",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artist deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Artist not found"
          }
        }
      }
    },

    "/artworks": {
      "get": {
        "summary": "List all artworks",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Create a new artwork",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Artwork created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },

    "/artworks/{id}": {
      "get": {
        "summary": "Get one artwork",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Artwork not found"
          }
        }
      },
      "put": {
        "summary": "Update an artwork",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artwork updated"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Artwork not found"
          }
        }
      },
      "delete": {
        "summary": "Delete an artwork",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artwork deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          },
          "404": {
            "description": "Artwork not found"
          }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid"
      }
    }
  }
}
