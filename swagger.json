{
  "openapi": "3.0.0",
  "info": {
    "title": "ArtCatalog Team 8 API",
    "version": "1.0.0",
    "description": "Public GET routes are available to everyone. Administrative POST, PUT and DELETE operations require GitHub authentication."
  },
  "servers": [
    { "url": "http://localhost:3000" },
    { "url": "https://artcatalog-team-8.onrender.com" }
  ],
  "paths": {
    "/artists": {
      "get": {
        "summary": "List all artists",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Create a new artist",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/artists/{id}": {
      "get": {
        "summary": "Get one artist",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "summary": "Update an artist",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Updated" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Delete an artist",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/artworks": {
      "get": {
        "summary": "List all artworks",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Create a new artwork",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/artworks/{id}": {
      "get": {
        "summary": "Get one artwork",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "summary": "Update an artwork",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Updated" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "summary": "Delete an artwork",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/auth/github": {
      "get": {
        "summary": "Admin GitHub Login",
        "responses": { "302": { "description": "Redirect to GitHub" } }
      }
    },
    "/auth/github/callback": {
      "get": {
        "summary": "GitHub OAuth Callback Handler",
        "responses": { "302": { "description": "Redirects to /api-docs on success" } }
      }
    },
    "/auth/logout": {
    "get": {
      "summary": "Logout and return to home page",
      "responses": {
        "302": {
          "description": "Logged out and redirected to the home page"
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid"
      }
    }
  }
}
